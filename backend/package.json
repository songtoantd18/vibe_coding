{
  "name": "techstore-backend",
  "version": "1.0.0",
  "description": "TechStore E-commerce Backend API with Express and Prisma",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "prisma generate",
    "postinstall": "prisma generate",
    "server": "node --watch server.js",
    "studio": "prisma studio --port 5555",
    "seed": "node prisma/seed.js",
    "dev": "concurrently -n \"API,STUDIO\" -c \"blue,green\" \"npm run server\" \"npm run studio\""
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "prisma": "^5.18.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
